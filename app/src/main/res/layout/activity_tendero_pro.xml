<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Prisma Pro Tendero"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========================================== -->
            <!-- ESTADO 1: PAYWALL WOMPI (BLOQUEADO / FREE) -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/layoutPaywall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Ficha Principal de Propuesta de Valor -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_radar_analytics" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRISMA PRO TENDERO"
                                android:textColor="#0F766E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_marginStart="8dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="B2B SAAS"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#475569"
                                android:background="#F1F5F9"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Inteligencia Territorial y Optimización de Surtido"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Analítica prescriptiva basada en volumen transaccional consolidado para prevenir quiebres de inventario y maximizar margen comercial."
                            android:textSize="13sp"
                            android:textColor="#475569"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="18dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9"
                            android:layout_marginBottom="16dp" />

                        <!-- Módulo 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_check_verified"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Radar Territorial de Demanda"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ranking de los 10 productos con mayor rotación zonal por barrio y localidad."
                                    android:textSize="12sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Módulo 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_check_verified"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Minería de Canasta (FP-Growth)"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Configuración de combos cruzados con alta tasa de afinidad para elevar ticket promedio."
                                    android:textSize="12sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Módulo 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_check_verified"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alertas de Abastecimiento Crítico"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Notificación preventiva ante fluctuaciones de inventario y reposición prioritaria."
                                    android:textSize="12sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Tarifa -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="#F8FAFC"
                            android:padding="14dp"
                            android:layout_marginTop="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TARIFA MENSUAL VINCULADA"
                                    android:textSize="10sp"
                                    android:letterSpacing="0.06"
                                    android:textStyle="bold"
                                    android:textColor="#64748B" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$49.000 COP / mes"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IVA 19% INCLUIDO"
                                android:textSize="10sp"
                                android:textColor="#0F766E"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:background="#F0FDFA"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Formulario Pasarela Wompi Bancolombia -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="#FFFFFF">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pasarela de Pago · Wompi Bancolombia"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A"
                            android:layout_marginBottom="12dp" />

                        <!-- Selector de medio de pago -->
                        <RadioGroup
                            android:id="@+id/rgMedioPago"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <RadioButton
                                android:id="@+id/rbNequi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nequi"
                                android:checked="true"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbTarjeta"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tarjeta"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbPse"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PSE"
                                android:textSize="13sp" />
                        </RadioGroup>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDatoPago"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            app:boxStrokeColor="#0F766E"
                            app:hintTextColor="#0F766E">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDatoPago"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Número de cuenta / celular Nequi"
                                android:inputType="phone"
                                android:text="3991111111"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F1F5F9"
                            android:padding="10dp"
                            android:text="Ambiente Sandbox: utilice 3991111111 (Nequi) o 4242424242424242 (Tarjeta) para procesar la transacción de forma inmediata."
                            android:textSize="11sp"
                            android:textColor="#475569"
                            android:layout_marginBottom="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPagarWompi"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Confirmar Suscripción · $49.000 COP"
                            android:backgroundTint="#0F766E"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />

                        <ProgressBar
                            android:id="@+id/pbCargandoPago"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:visibility="gone"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>


            <!-- ============================================== -->
            <!-- ESTADO 2: DASHBOARD PRO (DESBLOQUEADO / ACTIVO) -->
            <!-- ============================================== -->
            <LinearLayout
                android:id="@+id/layoutProContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Header de Estado de Suscripción -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SUSCRIPCIÓN ACTIVA"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="#0F766E"
                                android:background="#F0FDFA"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvDiasRestantes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 días restantes"
                                android:textSize="12sp"
                                android:textColor="#475569" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBarrioActivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zona Monitoreada: Kennedy Central"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Consolidado de rotación territorial calculado sobre pedidos de los últimos 30 días."
                            android:textSize="11sp"
                            android:textColor="#64748B"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sección 1: Top Rotación Zonal -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOP ROTACIÓN TERRITORIAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#64748B"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/llTopProductos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="#FFFFFF">

                        <!-- Item 01 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:text="01"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0F766E"
                                android:background="#F0FDFA" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leche Entera Alquería 1L"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lácteos · +24.0% demanda · Sugerido: $4.800"
                                    android:textSize="11sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPedir1"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Reponer"
                                android:textSize="11sp"
                                app:strokeColor="#0F766E"
                                android:textColor="#0F766E"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9" />

                        <!-- Item 02 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:text="02"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0F766E"
                                android:background="#F0FDFA" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Arroz Diana Tradicional 1kg"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Granos · +18.0% demanda · Sugerido: $5.200"
                                    android:textSize="11sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPedir2"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Reponer"
                                android:textSize="11sp"
                                app:strokeColor="#0F766E"
                                android:textColor="#0F766E"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9" />

                        <!-- Item 03 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:text="03"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0F766E"
                                android:background="#F0FDFA" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Aceite Premier 1000ml"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Abarrotes · +15.0% demanda · Sugerido: $10.500"
                                    android:textSize="11sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPedir3"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Reponer"
                                android:textSize="11sp"
                                app:strokeColor="#0F766E"
                                android:textColor="#0F766E"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F1F5F9" />

                        <!-- Item 04 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:text="04"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0F766E"
                                android:background="#F0FDFA" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Galletas Festival Chocolate"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Snacks · +20.0% demanda · Sugerido: $1.200"
                                    android:textSize="11sp"
                                    android:textColor="#64748B" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPedir4"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Reponer"
                                android:textSize="11sp"
                                app:strokeColor="#0F766E"
                                android:textColor="#0F766E"
                                app:cornerRadius="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sección 2: Minería de Canasta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGLAS DE ASOCIACIÓN DE CANASTA (FP-GROWTH)"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
