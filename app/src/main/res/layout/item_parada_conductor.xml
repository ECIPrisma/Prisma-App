<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/prisma_border"
    app:cardBackgroundColor="@color/prisma_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Número de Parada en Círculo -->
            <TextView
                android:id="@+id/tvStopNumber"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/prisma_white"
                android:background="@drawable/bg_button_teal"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStoreName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tienda La Bendición"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/prisma_text_primary" />

                <TextView
                    android:id="@+id/tvStoreAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calle 45 Sur # 78H-12, Kennedy"
                    android:textSize="11sp"
                    android:textColor="@color/prisma_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStopStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN RUTA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#92400E"
                android:background="@drawable/badge_pill_promo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- Detalle de Productos que trae el camión para esta parada -->
        <TextView
            android:id="@+id/tvItemsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_product_placeholder"
            android:padding="8dp"
            android:text="Carga a entregar:\n• 3x Coca-Cola Original 400ml\n• 1x Coca-Cola 1.5L"
            android:textSize="11sp"
            android:textColor="@color/prisma_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCashAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cobro: $126.000 COP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/prisma_teal_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Validar PIN ›"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/prisma_orange_dark" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
