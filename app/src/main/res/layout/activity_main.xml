<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/prisma_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/prisma_teal"
        app:title="@string/app_name"
        app:titleTextColor="@color/prisma_background" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Fondo vertical ilustrado con opacidad suave -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.18"
            android:src="@drawable/fondo_prisma_mobile" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_icono_tienda" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bienvenido a PRISMA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/prisma_text_primary" />

        <TextView
            android:id="@+id/tvUserRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rol: Repartidor"
            android:textSize="14sp"
            android:textColor="@color/prisma_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoModule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:text="Ir a Mi Módulo"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="@color/prisma_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Cerrar Sesión"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="@color/prisma_border"
            android:textColor="@color/status_red" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
